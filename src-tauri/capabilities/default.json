{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default launcher permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "deep-link:default",
    "dialog:default",
    "autostart:default",
    "opener:default",
    "shell:allow-open",
    "store:default"
  ]
}
